# SoloEnterprise Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Get this from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgres://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# REDIS (Upstash)
# =============================================================================
# Get this from: https://console.upstash.com → Your Database → REST API
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# =============================================================================
# GITHUB
# =============================================================================
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=mattbara/soloenterprise
GITHUB_BRANCH=development

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# ANTHROPIC (for AI agents)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-xxx

# Claude Model Configuration (optional - defaults shown)
# Models: claude-3-5-haiku-latest (fast, cheap), claude-sonnet-4-5-20250929 (quality), claude-opus-4-6 (reasoning)
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_TOKENS=16384

# Opus for reasoning-heavy tasks
ORCHESTRATOR_MODEL=claude-opus-4-6
REVIEWER_MODEL=claude-opus-4-6

# Sonnet for ALL code generation (this is the floor)
BACKEND_AGENT_MODEL=claude-sonnet-4-5-20250929
FRONTEND_AGENT_MODEL=claude-sonnet-4-5-20250929
QA_AGENT_MODEL=claude-sonnet-4-5-20250929
DEVOPS_AGENT_MODEL=claude-sonnet-4-5-20250929

# Haiku ONLY for routing/classification (no code)
ROUTER_MODEL=claude-haiku-4-5-20250929
