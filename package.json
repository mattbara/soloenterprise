{
  "name": "soloenterprise",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "test:all": "turbo run test",
    "lint:all": "turbo run lint",
    "db:generate": "pnpm --filter @soloenterprise/db generate",
    "db:migrate": "pnpm --filter @soloenterprise/db migrate",
    "db:push": "pnpm --filter @soloenterprise/db push",
    "db:studio": "pnpm --filter @soloenterprise/db studio",
    "test:echo": "tsx scripts/test-echo.ts",
    "test:backend": "tsx scripts/test-backend-agent.ts",
    "worker": "pnpm --filter @soloenterprise/core worker",
    "worker:echo": "pnpm --filter @soloenterprise/core worker:echo",
    "worker:backend": "pnpm --filter @soloenterprise/core worker:backend",
    "worker:frontend": "pnpm --filter @soloenterprise/core worker:frontend",
    "worker:qa": "pnpm --filter @soloenterprise/core worker:qa",
    "worker:orchestrator": "pnpm --filter @soloenterprise/core worker:orchestrator"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@soloenterprise/core": "workspace:^",
    "@soloenterprise/db": "workspace:^",
    "@soloenterprise/theme": "workspace:^",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "lucide-react": "^0.564.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
